{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servicedeckmanagement.dev/schemas/api.v1.schema.json",
  "title": "Service Deck Management API configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindAddress", "port", "remoteAccess"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bindAddress": { "const": "127.0.0.1" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "remoteAccess": { "const": false }
  }
}
