# Contexto de trabalho local: nunca publicar.
/.agents/
/AGENTS.md

# Runtime portátil: nunca publicar estado local, dados ou segredos.
/runtime/
/artifacts/
/dist/
/publish/
/logs/
/data/
/app/
/apps/
/dashboard/
/.dotnet/
/.dotnet-home/
/.packages/

# Configuração real é local. Somente documentação, schemas e exemplos públicos.
/config/*
!/config/README.md
!/config/examples/
!/config/examples/**
!/config/schemas/
!/config/schemas/**

