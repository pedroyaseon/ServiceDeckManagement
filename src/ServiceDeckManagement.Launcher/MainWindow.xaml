<Window x:Class="ServiceDeckManagement.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServiceDeckManagement.Launcher"
        Title="Service Deck Management" Width="1320" Height="820"
        MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <Window.Resources>
        <local:ServiceStateLabelConverter x:Key="ServiceStateLabelConverter" />
        <local:ServiceStateBrushConverter x:Key="ServiceStateBrushConverter" />
        <local:StartModeLabelConverter x:Key="StartModeLabelConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="SD" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Service Deck Management" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Launcher" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,1,0,0" />
                </StackPanel>
                <TextBlock x:Name="CurrentUserText" Grid.Column="2" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" FontSize="12" Text="Não autenticado" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPERAÇÃO" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="7" Margin="0,10,0,0" Padding="12,10">
                            <TextBlock Text="Serviços" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="Ações são executadas pela API. O Launcher não solicita elevação."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   LineHeight="17" Margin="4,14,4,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="ESTADO" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Ellipse x:Name="ApiStatusDot" Width="8" Height="8" Fill="#526174" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="API" Margin="9,0,0,0" FontSize="12" />
                            <TextBlock x:Name="ApiStatusText" Grid.Column="2" Text="Offline" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Ellipse x:Name="ManagerStatusDot" Width="8" Height="8" Fill="#526174" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Manager" Margin="9,0,0,0" FontSize="12" />
                            <TextBlock x:Name="ManagerStatusText" Grid.Column="2" Text="Offline" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="22,18,22,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Serviços" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServiceCountText" Text="Conecte-se para carregar o inventário"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="AddButton" Grid.Column="1" Content="Adicionar" Style="{StaticResource PrimaryButton}"
                            Width="112" Click="AddButton_Click" IsEnabled="False" />
                </Grid>

                <DataGrid x:Name="ServicesGrid" Grid.Row="1" Grid.Column="0" Margin="22,0,0,14"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionUnit="FullRow" AlternationCount="2" SelectionChanged="ServicesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="SERVIÇO" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Executable}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ESTADO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding State, Converter={StaticResource ServiceStateBrushConverter}}"
                                            CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding State, Converter={StaticResource ServiceStateLabelConverter}}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="INICIALIZAÇÃO"
                                            Binding="{Binding StartMode, Converter={StaticResource StartModeLabelConverter}}" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Grid.Column="1" Margin="14,0,22,14" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="#172231" CornerRadius="6" Padding="11,9">
                            <TextBlock x:Name="SelectedServiceName" Text="Nenhum serviço selecionado"
                                       FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock x:Name="SelectedServicePath" Grid.Row="1" Foreground="{StaticResource MutedBrush}"
                                   Text="Selecione uma linha para ver o executável." TextWrapping="Wrap"
                                   FontSize="11" Margin="2,10,2,14" MaxHeight="48" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Content="Iniciar" Style="{StaticResource ButtonBase}" Click="StartButton_Click" IsEnabled="False" />
                            <Button x:Name="StopButton" Grid.Column="2" Content="Parar" Style="{StaticResource ButtonBase}" Click="StopButton_Click" IsEnabled="False" />
                        </Grid>
                        <Button x:Name="RestartButton" Grid.Row="3" Content="Reiniciar" Style="{StaticResource ButtonBase}"
                                Margin="0,8,0,0" Click="RestartButton_Click" IsEnabled="False" />
                        <StackPanel Grid.Row="4" VerticalAlignment="Top" Margin="0,16,0,0">
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />
                            <Button x:Name="EditButton" Content="Editar" Style="{StaticResource ButtonBase}" Click="EditButton_Click" IsEnabled="False" />
                            <Button x:Name="RepairButton" Content="Reparar registro" Style="{StaticResource ButtonBase}"
                                    Margin="0,8,0,0" Click="RepairButton_Click" IsEnabled="False" />
                        </StackPanel>
                        <Button x:Name="RemoveButton" Grid.Row="5" Content="Remover" Style="{StaticResource DangerButton}"
                                Click="RemoveButton_Click" IsEnabled="False" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#080D12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="22,12,22,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Logs" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Limpar" Style="{StaticResource ButtonBase}" Padding="10,5" MinHeight="28" Click="ClearLogsButton_Click" />
                                <Button Content="Copiar" Style="{StaticResource ButtonBase}" Padding="10,5" MinHeight="28" Margin="8,0,0,0" Click="CopyLogsButton_Click" />
                                <Button Content="Exportar" Style="{StaticResource ButtonBase}" Padding="10,5" MinHeight="28" Margin="8,0,0,0" Click="ExportLogsButton_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="LogsTextBox" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="Selecione um serviço para carregar os logs." />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="FeedbackText" Text="Iniciando..." VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="v1.0.0-beta.2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Border>

        <Grid x:Name="AuthenticationOverlay" Grid.RowSpan="3" Background="#D90B0F14">
            <Border Width="420" Padding="26" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Conectar ao ambiente" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="AuthenticationHint" Text="Use sua conta local da API."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,20" />
                    <StackPanel x:Name="BootstrapPanel" Visibility="Collapsed">
                        <TextBlock Text="Código de inicialização" FontSize="12" Margin="0,0,0,6" />
                        <TextBox x:Name="BootstrapCodeTextBox" MaxLength="16" Margin="0,0,0,14" />
                    </StackPanel>
                    <TextBlock Text="Usuário" FontSize="12" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox" MaxLength="64" Margin="0,0,0,14" />
                    <TextBlock Text="Senha" FontSize="12" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordInput" MaxLength="128" Margin="0,0,0,18" />
                    <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" />
                    <TextBlock x:Name="AuthenticationError" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
